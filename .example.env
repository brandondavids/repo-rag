DISCORD_TOKEN=
DISCORD_OWNER_ID=
GEMINI_API_KEY=

# Optional. Use a guild ID while testing slash commands because guild sync is immediate.
# Leave blank for global commands after testing.
DISCORD_GUILD_ID=

DOCS_SOURCE_DIR=docs_source  # folder containing documents to index
CHROMA_DIR=knowledge_db
CHROMA_COLLECTION=personal_kb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2  # local embedding model name
GEMINI_MODEL=gemini-2.5-flash

# Daily Discord news digest. Use semicolon-separated RSS/Atom feed URLs.
# NEWS_CHANNEL_ID is the channel that receives the automated daily post.
NEWS_CHANNEL_ID=
NEWS_TIMEZONE=
NEWS_DIGEST_TIME=08:00  # daily send time in HH:MM
NEWS_LOOKBACK_HOURS=24  # recent news in the last 24 hours
NEWS_MAX_ITEMS_PER_CATEGORY=8
TECH_NEWS_FEEDS=https://news.google.com/rss/search?q=programming%20language%20OR%20software%20OR%20hardware%20OR%20framework%20when:1d&hl=en-US&gl=US&ceid=US:en;https://techcrunch.com/feed/;https://www.theverge.com/rss/index.xml;https://hnrss.org/frontpage
ANIME_MANGA_NEWS_FEEDS=https://news.google.com/rss/search?q=anime%20OR%20manga%20when:1d&hl=en-US&gl=US&ceid=US:en;https://www.animenewsnetwork.com/all/rss.xml

HF_TOKEN=